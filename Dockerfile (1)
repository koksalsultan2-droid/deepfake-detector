# Render (ya da Docker destekleyen herhangi bir platform) için
FROM node:20-slim

# ffmpeg'i sistem paketi olarak kur
RUN apt-get update && apt-get install -y ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

EXPOSE 3000

CMD ["node", "server-opensource.js"]
